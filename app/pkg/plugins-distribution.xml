<?xml version="1.0" encoding="utf-8"?>
<!-- The plug-ins alone (productbuild). The app carries this as Contents/Resources/Beat-Key-Plug-ins.pkg and opens it in
     Installer from Beat Key menu > Update Plug-ins... when the installed plug-ins are older than the app. No "Beat Key is
     open" check here: the app is what opens it. Versions are filled in by app/pkg/plugin-pkgs.sh. -->
<installer-gui-script minSpecVersion="2">
  <title>Beat Key Plug-ins</title>
  <organization>com.jshriver</organization>
  <options customize="allow" require-scripts="false" hostArchitectures="arm64,x86_64"/>
  <os-version min="12.0"/>
  <domains enable_anywhere="false" enable_currentUserHome="false" enable_localSystem="true"/>
  <choices-outline>
    <line choice="default">
      <line choice="com.jshriver.orion.plugin.au"/>
      <line choice="com.jshriver.orion.plugin.vst3"/>
      <!-- BEGIN AAX -->
      <line choice="com.jshriver.orion.plugin.aax"/>
      <!-- END AAX -->
      <line choice="com.jshriver.orion.plugin.midi.au"/>
      <line choice="com.jshriver.orion.plugin.midi.vst3"/>
      <!-- BEGIN AAX -->
      <line choice="com.jshriver.orion.plugin.midi.aax"/>
      <!-- END AAX -->
    </line>
  </choices-outline>
  <choice id="default"/>
  <choice id="com.jshriver.orion.plugin.au" start_selected="true" title="Audio Unit" description="For Audio Unit hosts such as Logic Pro. Installs to /Library/Audio/Plug-Ins/Components.">
    <pkg-ref id="com.jshriver.orion.plugin.au.pkg"/>
  </choice>
  <choice id="com.jshriver.orion.plugin.vst3" start_selected="true" title="VST3" description="For VST3 hosts. Installs to /Library/Audio/Plug-Ins/VST3.">
    <pkg-ref id="com.jshriver.orion.plugin.vst3.pkg"/>
  </choice>
  <!-- BEGIN AAX -->
  <choice id="com.jshriver.orion.plugin.aax" start_selected="true" title="AAX" description="For Pro Tools. Installs to /Library/Application Support/Avid/Audio/Plug-Ins.">
    <pkg-ref id="com.jshriver.orion.plugin.aax.pkg"/>
  </choice>
  <!-- END AAX -->
  <choice id="com.jshriver.orion.plugin.midi.au" start_selected="true" title="Audio Unit: Beat Key MIDI" description="Beat Key MIDI: the key in use as MIDI notes, plus a drag-out MIDI file. Installs to /Library/Audio/Plug-Ins/Components.">
    <pkg-ref id="com.jshriver.orion.plugin.midi.au.pkg"/>
  </choice>
  <choice id="com.jshriver.orion.plugin.midi.vst3" start_selected="true" title="VST3: Beat Key MIDI" description="Beat Key MIDI: the key in use as MIDI notes, plus a drag-out MIDI file. Installs to /Library/Audio/Plug-Ins/VST3.">
    <pkg-ref id="com.jshriver.orion.plugin.midi.vst3.pkg"/>
  </choice>
  <!-- BEGIN AAX -->
  <choice id="com.jshriver.orion.plugin.midi.aax" start_selected="true" title="AAX: Beat Key MIDI" description="Beat Key MIDI for Pro Tools. Installs to /Library/Application Support/Avid/Audio/Plug-Ins.">
    <pkg-ref id="com.jshriver.orion.plugin.midi.aax.pkg"/>
  </choice>
  <!-- END AAX -->
  <pkg-ref id="com.jshriver.orion.plugin.au.pkg" version="@VERSION@" onConclusion="none">Beat-Key-AU.pkg</pkg-ref>
  <pkg-ref id="com.jshriver.orion.plugin.vst3.pkg" version="@VERSION@" onConclusion="none">Beat-Key-VST3.pkg</pkg-ref>
  <!-- BEGIN AAX -->
  <pkg-ref id="com.jshriver.orion.plugin.aax.pkg" version="@VERSION@" onConclusion="none">Beat-Key-AAX.pkg</pkg-ref>
  <!-- END AAX -->
  <pkg-ref id="com.jshriver.orion.plugin.midi.au.pkg" version="@VERSION@" onConclusion="none">Beat-Key-AU-MIDI.pkg</pkg-ref>
  <pkg-ref id="com.jshriver.orion.plugin.midi.vst3.pkg" version="@VERSION@" onConclusion="none">Beat-Key-VST3-MIDI.pkg</pkg-ref>
  <!-- BEGIN AAX -->
  <pkg-ref id="com.jshriver.orion.plugin.midi.aax.pkg" version="@VERSION@" onConclusion="none">Beat-Key-AAX-MIDI.pkg</pkg-ref>
  <!-- END AAX -->
</installer-gui-script>
